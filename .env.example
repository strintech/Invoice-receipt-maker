# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://invoices:invoices@localhost:5432/invoices

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# PDF Generation
PDF_TIMEOUT=30000

# Email (registration confirmation links). Defaults send to Mailpit: `docker compose up -d mailpit`, inbox at http://localhost:8025
# APP_URL is where the emailed links point (the frontend). Default: http://localhost:5173 (Vite dev server)
# APP_URL=https://app.example.com
# SMTP_URL=smtp://localhost:1025
# Production example (Postmark; port 2525 because Render free blocks 25/465/587). URL-encode special chars.
# SMTP_URL=smtp://<server-token>:<server-token>@smtp.postmarkapp.com:2525
# MAIL_FROM=Invoice Maker <no-reply@example.com>

# Confirm accounts at sign-up without sending an email (until production SMTP is set up)
# SKIP_EMAIL_VERIFICATION=true
